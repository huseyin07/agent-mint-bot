# Agentic Wallet'ın BSC adresi (herkese açık adres, gizli değil)
AGENT_WALLET=0xab9a1c1ac28f4688eeb49ce86803785d2f6190b5

# Telegram: @BotFather'dan bot token, @userinfobot'tan kendi chat id'n
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true iken hiçbir işlem gönderilmez, sadece "mint edilebilirdi" bildirimi gelir.
# Birkaç gün izleyip memnun kalınca false yap.
DRY_RUN=true

# Güvenlik tavanları
MAX_MINTS_PER_DAY=15
MAX_GAS_BNB_PER_DAY=0.0005
MIN_BNB_RESERVE=0.0003
MAX_QUANTITY=1

# Zincir
BSC_RPC_URL=https://bsc-rpc.publicnode.com
POLL_MS=3000
MAX_BLOCKS_PER_TICK=20

# İsteğe bağlı: etherscan.io API anahtarı (BscScan doğrulaması için yedek kaynak)
ETHERSCAN_API_KEY=
REQUIRE_EXACT_MATCH=false
UNVERIFIED_RETRY_MINUTES=5
UNVERIFIED_GIVE_UP_HOURS=6

# Railway'de Dockerfile bunları zaten /data altına ayarlar
# BINANCE_BAW_DIR=/data/baw
# STATE_PATH=/data/state.json
